# Copia este archivo como .env y completa los valores reales.
# Nunca subas el .env al repositorio.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Connection string de Neon (branch dev para desarrollo local)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# Dominios del frontend autorizados (Vercel en producción)
CORS_ALLOWED_ORIGINS=http://localhost:3000
